<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The daily check for a new release on GitHub, and downloading it. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Installing that release over this one; Android asks the owner once, at the first install. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Speech input: hold the period, or the orange key then the period. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Android 11 and later hide other apps' speech recognisers unless asked for by name. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true">
        <!-- The keyboard itself. Only the input-method system may bind it. -->
        <service android:name=".KeyboardService"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method" />
        </service>
        <!-- Sideloaded keyboards have to be enabled and then chosen by hand; this activity is
             both the launcher entry and the gear beside the entry in Language & input. -->
        <activity android:name=".SetupActivity" android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The update popup: a dialog of its own, apart from the setup screen's task. -->
        <activity android:name=".UpdateActivity" android:exported="false"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.DeviceDefault.Dialog"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:excludeFromRecents="true" />
        <!-- Asks for the microphone the first time speech input is used. -->
        <activity android:name=".MicActivity" android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:taskAffinity=""
            android:excludeFromRecents="true" />
    </application>
</manifest>
